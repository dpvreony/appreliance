<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--<add key="DHGMS_Dev" value="https://dpvreony.pkgs.visualstudio.com/_packaging/DHGMS_Dev/nuget/v3/index.json" />-->
  </packageSources>

  <!-- Define mappings by adding package patterns beneath the target source. -->
  <!-- Contoso.* packages and NuGet.Common will be restored from contoso.com,
       everything else from nuget.org. -->
  <packageSourceMapping>
    <!-- key value for <packageSource> should match key values from <packageSources> element -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!--
    <packageSource key="DHGMS_Dev">
      <package pattern="Dhgms.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
